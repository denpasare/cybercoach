# --- Database -----------------------------------------------------------
# Postgres connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/emailyzer?schema=public"

# --- NextAuth -----------------------------------------------------------
# Generate with:  openssl rand -base64 32
AUTH_SECRET=""
# Public URL of the app (no trailing slash). For local dev: http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"

# --- Microsoft Entra ID (Azure AD) --------------------------------------
# App (client) ID from the Azure portal
AUTH_MICROSOFT_ENTRA_ID_ID=""
# Client secret value
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# Tenant ID, or "common" for multi-tenant + personal accounts
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID="common"

# --- Encryption ---------------------------------------------------------
# 32-byte key, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""
